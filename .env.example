# OpenSearch (TEXT / HYBRID text leg)
OPENSEARCH_HOST=localhost
OPENSEARCH_PORT=9200
OPENSEARCH_INDEX=ic_kb_chunk_idx

# Vector service (VECTOR / HYBRID vector leg, Java -> Python FastAPI)
VECTOR_SERVICE_HOST=127.0.0.1
VECTOR_SERVICE_PORT=8099

# KB local file storage root (LOCAL storageType)
KB_STORAGE_BASE_DIR=./upload-files/kb

# Demo switches
DEMO_MODE=1
